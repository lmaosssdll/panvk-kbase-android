name: Build PanVK glibc for Mali-G52

on:
  workflow_dispatch:

jobs:
  build-glibc:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            qemu-user-static \
            qemu-system-arm \
            binfmt-support \
            gcc-aarch64-linux-gnu \
            g++-aarch64-linux-gnu \
            libc6-dev-arm64-cross \
            clang \
            meson \
            ninja-build \
            pkg-config \
            python3 \
            git \
            ca-certificates

      - name: Setup QEMU for aarch64
        run: |
          sudo update-binfmts --enable qemu-aarch64
          sudo update-binfmts --display qemu-aarch64

      - name: Fetch Mesa source
        run: |
          chmod +x scripts/*.sh
          ./scripts/fetch-mesa.sh build/reconstructed-test/mesa

      - name: Apply patches for G52
        run: |
          ./scripts/apply-patches.sh --profile g52-v7-jm --mesa build/reconstructed-test/mesa

      - name: Configure and build with Meson (cross-compile)
        run: |
          mkdir -p dist/glibc-g52-v7-jm
          
          # Создаем cross file для aarch64
          cat > cross-aarch64.ini << 'EOF'
          [binaries]
          c = 'aarch64-linux-gnu-gcc'
          cpp = 'aarch64-linux-gnu-g++'
          ar = 'aarch64-linux-gnu-ar'
          strip = 'aarch64-linux-gnu-strip'
          pkg-config = 'pkg-config'
          
          [host_machine]
          system = 'linux'
          cpu_family = 'aarch64'
          cpu = 'aarch64'
          endian = 'little'
          
          [properties]
          c_args = []
          c_link_args = []
          EOF
          
          # Настраиваем сборку
          meson setup build/linux-glibc-g52 build/reconstructed-test/mesa \
            --cross-file cross-aarch64.ini \
            -Dbuildtype=release \
            -Dplatforms=x11,wayland \
            -Dgallium-drivers= \
            -Dvulkan-drivers=panfrost \
            -Dpanfrost-kmds=kbase \
            -Degl=disabled -Dgles1=disabled -Dgles2=disabled -Dopengl=false \
            -Dglx=disabled -Dgbm=disabled -Dzstd=disabled -Dlibunwind=disabled
          
          # Собираем
          ninja -j2 -C build/linux-glibc-g52

      - name: Copy artifacts
        run: |
          find build/linux-glibc-g52 -name 'libvulkan_panfrost.so' -exec cp {} dist/glibc-g52-v7-jm/ \;
          find build/linux-glibc-g52 -name 'panfrost_icd.*.json' -exec cp {} dist/glibc-g52-v7-jm/panfrost_icd.aarch64.json \;
          ls -lh dist/glibc-g52-v7-jm/

      - name: Verify build
        run: |
          cd dist/glibc-g52-v7-jm
          file libvulkan_panfrost.so
          readelf -h libvulkan_panfrost.so | grep -i "machine"
          cat panfrost_icd.aarch64.json

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: panvk-glibc-mali-g52
          path: dist/glibc-g52-v7-jm/
          retention-days: 30
